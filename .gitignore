# Ignore Python cache files
__pycache__/
*.py[cod]
*$py.class

# Ignore pentest documentation file
pentest.mdc

# Ignore compiled bytecode
*.pyc
*.pyo

# Ignore distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# Ignore logs and local files
*.log
.env
.venv
venv/

# Scan outputs can contain sensitive target data
results.*
manager_results.*
report.*
smoke*.json
*.sarif

# Local caches and tool state
data/cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
ENV/

# Ignore IDE specific files
.idea/
.vscode/
*.swp
*.swo
